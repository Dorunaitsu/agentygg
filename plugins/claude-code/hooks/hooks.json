{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ygg",
            "args": [
              "listen",
              "--hook",
              "--here"
            ],
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ygg",
            "args": [
              "listen",
              "--hook",
              "--here"
            ],
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
