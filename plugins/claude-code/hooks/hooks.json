{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/ensure-ygg.sh\" || exit 0",
            "timeout": 300
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ygg",
            "args": [
              "listen",
              "--hook",
              "--here"
            ],
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ygg",
            "args": [
              "listen",
              "--hook",
              "--here"
            ],
            "asyncRewake": true,
            "timeout": 86400
          }
        ]
      }
    ]
  }
}
